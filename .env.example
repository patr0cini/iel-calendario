# Frontend (Vite) — only PUBLIC values here. Never put service_role or secrets.
# The browser NEVER talks to the Postgres REST API; it only calls the Edge Functions.

# Base path for GitHub Pages. For a project site it must be "/<repo>/".
# For local dev leave it as "/".
VITE_BASE_PATH=/

# Base URL of the Supabase Edge Functions, e.g.:
#   local:      http://127.0.0.1:54321/functions/v1
#   production: https://<project-ref>.supabase.co/functions/v1
VITE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

# Microsoft 365 sign-in (Entra ID App Registration). Public identifiers, not
# secrets. Leave empty to hide the "Iniciar sessão com a Microsoft" button.
VITE_MS_CLIENT_ID=
VITE_MS_TENANT_ID=
